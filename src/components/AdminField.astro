---
import { imageUrl } from '../lib/content';
interface Props { name: string; label: string; value?: string | number | boolean | null; type?: 'text' | 'textarea' | 'select' | 'image' | 'checkbox' | 'number' | 'url' | 'date'; required?: boolean; options?: { value: string; label: string }[]; help?: string; }
const { name, label, value, type = 'text', required = false, options = [], help } = Astro.props;
---
{type === 'checkbox' ? <label class="check"><input type="checkbox" name={name} checked={!!value}/><span>{label}</span></label> : <div class="field"><label for={name}>{label}{required && ' *'}</label>{type === 'textarea' ? <textarea id={name} name={name} required={required} maxlength="12000">{value}</textarea> : type === 'select' ? <select id={name} name={name} required={required}>{options.map(option => <option value={option.value} selected={option.value === value}>{option.label}</option>)}</select> : type === 'image' ? <div data-upload><input type="hidden" name={name} value={String(value || '')}/><input id={name} type="file" accept="image/jpeg,image/png,image/webp" data-file/><img class="upload-preview" src={value ? imageUrl(String(value), 480) : undefined} hidden={!value} alt={`Vista previa: ${label}`}/><button type="button" class="text-link" data-remove>Quitar imagen</button><small data-upload-status role="status">JPG, PNG o WebP. Hasta 10 MB. Mínimo 200 × 200 píxeles.</small></div> : <input id={name} name={name} value={String(value ?? '')} type={type} required={required} min={type === 'number' ? '0' : undefined} maxlength="180"/>}{help && <small>{help}</small>}</div>}
