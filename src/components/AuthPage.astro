---
import '../styles/global.css';
import { configuration } from '../lib/content';
const { mode } = Astro.props as { mode: string };
if (!['login', 'recuperar', 'restablecer'].includes(mode || '')) return Astro.rewrite('/404');
if (mode === 'restablecer' && !Astro.locals.user) return Astro.redirect('/admin/recuperar');
const title = mode === 'login' ? 'Tu espacio, Alexandra.' : mode === 'recuperar' ? 'Recupera tu acceso.' : 'Nueva contraseña.';
const configured = !!configuration().url && !!configuration().key;
---
<!doctype html><html lang="es"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><meta name="robots" content="noindex,nofollow"/><title>{title} · Alexandra Sánchez</title></head><body><main class="login"><a class="brand" href="/">Alexandra Sánchez<small>Acceso privado</small></a><h1 style="margin-top:3rem">{title}</h1><p class="muted">{mode === 'login' ? 'Entra para cuidar los contenidos de tu web.' : 'Te ayudamos a volver a tu panel.'}</p>{!configured && <p class="notice" role="status">El acceso privado estará disponible cuando se complete la conexión con Supabase.</p>}{Astro.url.searchParams.has('error') && <p class="notice" role="alert">No se pudo completar la solicitud. Revisa los datos o solicita un nuevo enlace de recuperación.</p>}{Astro.url.searchParams.has('sent') && <p class="notice" role="status">Si la dirección corresponde a una cuenta, recibirás un enlace para recuperar el acceso. Ábrelo en este mismo navegador.</p>}{Astro.url.searchParams.has('updated') && <p class="notice">Contraseña actualizada. Ya puedes iniciar sesión.</p>}<form method="post" action={`/api/auth/${mode === 'login' ? 'login' : mode === 'recuperar' ? 'recover' : 'password'}`}>{mode !== 'restablecer' && <label class="field">Correo electrónico<input name="email" type="email" autocomplete="username" required maxlength="254"/></label>}{mode !== 'recuperar' && <label class="field">Contraseña<input name="password" type="password" autocomplete={mode === 'login' ? 'current-password' : 'new-password'} required minlength={mode === 'restablecer' ? 12 : 1} maxlength="128"/>{mode === 'restablecer' && <small>Utiliza al menos 12 caracteres.</small>}</label>}<button class="button" disabled={!configured}>{mode === 'login' ? 'Entrar al panel →' : mode === 'recuperar' ? 'Enviar enlace' : 'Guardar contraseña'}</button></form><p style="margin-top:2rem"><a class="text-link" href={mode === 'login' ? '/admin/recuperar' : '/admin/login'}>{mode === 'login' ? 'He olvidado mi contraseña' : 'Volver al acceso'}</a></p></main></body></html>
