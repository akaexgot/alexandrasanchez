---
import Layout from '../layouts/PublicLayout.astro';
import TreatmentCard from '../components/TreatmentCard.astro';
import FAQ from '../components/FAQ.astro';
import Gallery from '../components/Gallery.astro';
import Instagram from '../components/Instagram.astro';
import { content, home, business, imageUrl } from '../lib/content';
const [homes, treatments, results, testimonials, faqs, settings] = await Promise.all([content('inicio'), content('tratamientos'), content('resultados'), content('opiniones'), content('preguntas-frecuentes'), content('negocio')]);
const intro = homes[0] || home, info = settings[0] || business;
---
<Layout><section class="hero wrap"><div class="hero-copy"><span class="eyebrow">Alexandra Sánchez · Belleza en los detalles</span><h1>{intro.title}</h1><p>{intro.subtitle}</p><div class="actions"><a class="button" href={`https://wa.me/${info.whatsapp}`}>{intro.cta || home.cta} ↗</a><a class="text-link" href="/tratamientos">Explorar tratamientos</a></div><p class="hero-note">MICROPIGMENTACIÓN & ESTÉTICA DE LA MIRADA</p></div><div class="hero-art">{intro.image_id ? <img src={imageUrl(intro.image_id, 1200)} alt="Alexandra Sánchez · Micropigmentación y estética de la mirada" width="720" height="900" fetchpriority="high"/> : <><svg viewBox="0 0 600 750" fill="none" aria-hidden="true"><defs><linearGradient id="sand" x2="1" y2="1"><stop stop-color="#ddd0bc"/><stop offset="1" stop-color="#bba58d"/></linearGradient></defs><path fill="url(#sand)" d="M0 0h600v750H0z"/><ellipse cx="380" cy="720" rx="300" ry="470" fill="#ece2d4"/><path d="M385 140c-100 10-180 115-170 220 5 55 45 98 28 150-10 33-32 43-32 60 0 19 31 27 61 21-12 30-6 48 17 54-4 23 5 38 35 41 35 4 62-9 85-29" stroke="#7d6956" stroke-width="2"/><path d="M250 373c33-21 71-20 104-4M263 400c25 19 52 16 76 0M273 409l-6 10m20-5-3 11m20-10 1 11m15-15 5 9M278 599c17-8 35-8 51-1" stroke="#7d6956" stroke-width="2" stroke-linecap="round"/><circle cx="420" cy="298" r="130" stroke="#f7f4ee" stroke-opacity=".4"/><path d="M60 620V165c0-175 280-175 280 0" stroke="#f7f4ee" stroke-opacity=".6"/></svg><span class="art-caption">Ilustración · Identidad provisional</span></>}</div></section>
<div class="strip wrap"><span>Tu expresión</span><span>Atención personalizada</span><span>Belleza en los detalles</span></div>
<section class="section wrap split"><div><span class="eyebrow">Un espacio para ti</span><h2>La belleza está<br/>en lo que te hace única.</h2></div><div><p>{intro.introduction}</p><p class="muted">Soy Alexandra. Te invito a conocer mis tratamientos de micropigmentación y estética de la mirada, y a conversar sobre lo que buscas.</p><a class="text-link" href="/sobre-mi">Conoce mi espacio ↗</a></div></section>
<section class="wash"><div class="section wrap"><div class="section-head"><div><span class="eyebrow">Tratamientos</span><h2>Pequeños detalles.<br/>Tu propia expresión.</h2></div><a class="text-link" href="/tratamientos">Ver todos los tratamientos ↗</a></div><div class="grid">{treatments.filter(t => t.featured).slice(0, 3).map(item => <TreatmentCard item={item}/>)}</div></div></section>
<section class="section wrap split"><div><span class="eyebrow">Mi forma de entender la belleza</span><p class="quote">Escucharte.<br/>Cuidar los detalles.<br/><em>Respetar tu esencia.</em></p></div><div><h3>Todo empieza por conocerte.</h3><p class="muted">Una conversación para entender tus preferencias, resolver tus preguntas y hablar de las posibilidades de cada tratamiento. Sin prisas para decidir.</p><a class="text-link" href="/contacto">Hablemos ↗</a></div></section>
<section class="section wrap"><div class="section-head"><div><span class="eyebrow">Galería</span><h2>Una mirada al detalle.</h2></div><a class="text-link" href="/resultados">Explorar resultados ↗</a></div>{results.length ? <Gallery items={results.filter(r => r.featured).slice(0, 3)}/> : <p class="empty">Estamos preparando la galería de trabajos. Puedes contactar con Alexandra para conocer más sobre los tratamientos.</p>}</section>
<section class="wash"><div class="section wrap"><span class="eyebrow">Vuestras experiencias</span><h2>La confianza se comparte.</h2>{testimonials.length ? <div class="grid">{testimonials.slice(0, 3).map(t => <blockquote><p>{t.description}</p><cite>{t.author}</cite></blockquote>)}</div> : <p class="muted">Próximamente compartiremos opiniones autorizadas de nuestras clientas.</p>}</div></section>
<section class="section wrap split"><div><span class="eyebrow">Antes de dar el paso</span><h2>¿Hablamos<br/>de tus dudas?</h2><a class="text-link" href="/preguntas-frecuentes">Todas las preguntas ↗</a></div><div>{faqs.length ? <FAQ items={faqs.slice(0, 5)}/> : <p class="muted">Si quieres saber más sobre un tratamiento, escríbeme. Te atenderé de forma personalizada.</p>}</div></section>
<section class="section wrap"><span class="eyebrow">Nos vemos en Instagram</span><h2>@micro.alexandrasanchez</h2><p class="muted">Descubre el día a día del espacio y las últimas publicaciones.</p><a class="text-link" href={info.instagram}>Visitar el perfil ↗</a><Instagram posts={intro.instagram_posts}/></section></Layout>
