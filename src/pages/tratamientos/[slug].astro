---
import Layout from '../../layouts/PublicLayout.astro';
import FAQ from '../../components/FAQ.astro';
import { treatmentBySlug, content, imageUrl } from '../../lib/content';
const item = await treatmentBySlug(Astro.params.slug || '');
if (!item) return Astro.rewrite('/404');
const faqs = await content('preguntas-frecuentes', { treatment: item.id });
---
<Layout title={item.seo_title || item.title} description={item.seo_description || item.summary}><div class="wrap"><nav class="breadcrumbs" aria-label="Ruta de navegación"><a href="/">Inicio</a> / <a href="/tratamientos">Tratamientos</a> / {item.title}</nav><header class="page-head"><span class="eyebrow">{item.category}</span><h1>{item.title}</h1><p>{item.summary}</p></header><section class="section split" style="padding-top:20px"><div>{item.image_id && <img src={imageUrl(item.image_id)} alt={item.title} width="720" height="900"/>}<p class="prose">{item.description}</p></div><div>{[['Duración de la sesión', item.session_duration], ['Duración estimada de los resultados', item.result_duration], ['Cuidados previos', item.before_care], ['Cuidados posteriores', item.after_care], ['Retoques', item.touch_up]].map(([label, value]) => value && <section><h3>{label}</h3><p class="prose">{value}</p></section>)}<p class="muted">Consulta con Alexandra la información y los cuidados específicos de este tratamiento.</p><a class="button" href="/contacto">Consultar este tratamiento ↗</a></div></section>{(item.detail_image_id || item.second_detail_image_id) && <section class="section"><h2>Un vistazo al tratamiento</h2><div class="grid">{[item.detail_image_id, item.second_detail_image_id].filter(Boolean).map((id, i) => <img src={imageUrl(id, 960)} alt={`${item.title}: detalle ${i + 1}`} loading="lazy" width="720" height="900"/>)}</div></section>}{faqs.length > 0 && <section class="section"><h2>Sobre este tratamiento</h2><FAQ items={faqs}/></section>}</div></Layout>
