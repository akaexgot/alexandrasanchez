---
import Layout from '../layouts/PublicLayout.astro';
import FAQ from '../components/FAQ.astro';
import Gallery from '../components/Gallery.astro';
import TreatmentCard from '../components/TreatmentCard.astro';
import { content, business, imageUrl } from '../lib/content';
const pages: Record<string, [string, string]> = {
  'sobre-mi': ['Sobre mí', 'Un espacio para tu expresión.'], tratamientos: ['Tratamientos', 'Encuentra tu forma de mirar.'], resultados: ['Resultados', 'La belleza, en los detalles.'], opiniones: ['Opiniones', 'La confianza se comparte.'], 'preguntas-frecuentes': ['Preguntas frecuentes', 'Tus dudas merecen su espacio.'], contacto: ['Contacto', 'Todo empieza con una conversación.'], 'aviso-legal': ['Aviso legal', 'Información del sitio'], 'politica-de-privacidad': ['Política de privacidad', 'Información sobre tus datos'], 'politica-de-cookies': ['Política de cookies', 'Tus preferencias de privacidad'],
};
const page = Astro.params.page || '';
if (!pages[page]) return Astro.rewrite('/404');
const [title, subtitle] = pages[page];
const settings = (await content('negocio'))[0] || business;
const treatments = ['tratamientos', 'resultados'].includes(page) ? await content('tratamientos') : [];
const pageNumber = Math.max(1, Math.min(10000, Number(Astro.url.searchParams.get('pagina')) || 1));
const filter = Astro.url.searchParams.get('tratamiento') || '';
const rows = ['resultados', 'opiniones', 'preguntas-frecuentes'].includes(page) ? await content(page as 'resultados' | 'opiniones' | 'preguntas-frecuentes', { page: pageNumber, treatment: /^[0-9a-f-]{36}$/.test(filter) ? filter : undefined }) : [];
const legal = ['aviso-legal', 'politica-de-privacidad', 'politica-de-cookies'].includes(page);
---
<Layout title={title} description={subtitle} noindex={legal}><div class="wrap"><nav class="breadcrumbs" aria-label="Ruta de navegación"><a href="/">Inicio</a> / {title}</nav><header class="page-head"><span class="eyebrow">{title}</span><h1>{subtitle}</h1></header><section class="section" style="padding-top:20px">
{page === 'tratamientos' && <>{['Micropigmentación', 'Estética de la mirada'].map(category => <section style="margin-bottom:4rem"><h2>{category}</h2><div class="grid">{treatments.filter(t => t.category === category).map(item => <TreatmentCard item={item}/>)}</div></section>)}</>}
{page === 'sobre-mi' && <div class="split"><div>{settings.image_id ? <img src={imageUrl(settings.image_id)} alt="Alexandra Sánchez" width="600" height="750"/> : <div class="empty"><span class="brand">Alexandra Sánchez</span><p>Micropigmentación y estética de la mirada.</p></div>}</div><div><h2>Tu esencia,<br/>en primer plano.</h2><p class="prose">{settings.biography}</p><h3>Una atención que empieza por escucharte</h3><p>Cuéntame lo que buscas y tus preferencias. Hablaremos de los tratamientos y resolveremos tus dudas antes de dar el siguiente paso.</p><a class="text-link" href="/contacto">Contactar con Alexandra ↗</a></div></div>}
{page === 'resultados' && <div id="gallery-content"><nav class="filters" aria-label="Filtrar por tratamiento"><a href="/resultados" aria-current={!filter ? 'true' : undefined}>Todos</a>{treatments.map(t => <a href={`/resultados?tratamiento=${t.id}`} aria-current={filter === t.id ? 'true' : undefined}>{t.title}</a>)}</nav><p class="muted" aria-live="polite">{rows.length ? 'Mueve el control para comparar las imágenes.' : 'Todavía no hay resultados publicados para esta selección.'}</p><Gallery items={rows}/><nav class="pagination" aria-label="Paginación">{pageNumber > 1 && <a class="button secondary" href={`?pagina=${pageNumber - 1}&tratamiento=${filter}`}>Anterior</a>}{rows.length === 24 && <a class="button secondary" href={`?pagina=${pageNumber + 1}&tratamiento=${filter}`}>Siguiente</a>}</nav></div>}
{page === 'opiniones' && (rows.length ? <><div class="grid">{rows.map(t => <blockquote class="admin-card"><p>{t.description}</p><cite>{t.author}</cite>{t.date && <p><time datetime={t.date}>{new Date(t.date).toLocaleDateString('es-ES')}</time></p>}</blockquote>)}</div><nav class="pagination">{pageNumber > 1 && <a href={`?pagina=${pageNumber - 1}`}>Anterior</a>}{rows.length === 24 && <a href={`?pagina=${pageNumber + 1}`}>Siguiente</a>}</nav></> : <p class="empty">Estamos preparando este espacio para compartir experiencias reales y autorizadas.</p>)}
{page === 'preguntas-frecuentes' && (rows.length ? <><FAQ items={rows}/><nav class="pagination">{pageNumber > 1 && <a href={`?pagina=${pageNumber - 1}`}>Anterior</a>}{rows.length === 24 && <a href={`?pagina=${pageNumber + 1}`}>Siguiente</a>}</nav></> : <p class="empty">¿Tienes alguna pregunta? Contacta con Alexandra para recibir información personalizada.</p>)}
{page === 'contacto' && <div class="split"><div><span class="eyebrow">Hablemos</span><h2>Estoy al otro lado.</h2><p>Para conocer los tratamientos y resolver tus dudas, escríbeme por WhatsApp o llámame.</p><div class="actions"><a class="button" href={`https://wa.me/${settings.whatsapp}`}>WhatsApp ↗</a><a class="text-link" href={`tel:+34${settings.phone}`}>{settings.phone}</a></div></div><div><h3>Encuéntrame también en</h3><p><a class="text-link" href={settings.instagram}>Instagram ↗</a></p>{settings.facebook && <p><a class="text-link" href={settings.facebook}>Facebook ↗</a></p>}{settings.address && <><h3>Dirección</h3><p>{settings.address}</p></>}{settings.hours && <><h3>Horario</h3><p class="prose">{settings.hours}</p></>}</div></div>}
{legal && <div class="prose"><p class="notice">Documento provisional. Pendiente de completar con los datos del titular y de revisión profesional antes de la publicación definitiva.</p>{page === 'aviso-legal' && <><h2>Identificación del titular</h2><p>Nombre comercial: Alexandra Sánchez. Teléfono de contacto: 626836018.</p><p>Pendientes: identidad fiscal del titular, NIF, domicilio y datos adicionales que correspondan. Este documento no constituye un aviso legal completo.</p></>}{page === 'politica-de-privacidad' && <><h2>Tratamiento de datos</h2><p>Pendiente de definir y revisar: responsable, finalidades, base jurídica, destinatarios, transferencias, plazos de conservación y procedimiento para ejercer derechos.</p><p>El sitio no dispone de formulario de contacto. Al contactar mediante WhatsApp, teléfono o Instagram se aplican también las condiciones de los servicios utilizados. El panel privado utiliza Supabase para autenticar a sus usuarios y guardar contenidos.</p></>}{page === 'politica-de-cookies' && <><h2>Uso de recursos externos</h2><p>La navegación pública no incorpora analítica ni publicidad. El acceso privado utiliza cookies de autenticación. Las publicaciones de Instagram solo se cargan tras pulsar el botón de permiso de cada publicación.</p><p>El permiso no se conserva entre visitas. Puedes cerrar cada incrustación con su botón «Retirar permiso y cerrar». Las cookies ya creadas por terceros se gestionan desde el navegador.</p><p>Pendiente de auditoría final: inventario de cookies, proveedores, duración y configuración efectiva del entorno de producción.</p></>}</div>}
</section></div></Layout>
<script>
document.addEventListener('click', async event => {
  const anchor = (event.target as HTMLElement).closest<HTMLAnchorElement>('#gallery-content .filters a');
  if (!anchor || (event as MouseEvent).ctrlKey || (event as MouseEvent).metaKey) return;
  event.preventDefault();
  const target = document.querySelector('#gallery-content')!;
  target.setAttribute('aria-busy', 'true');
  try { const response = await fetch(anchor.href); if (!response.ok) throw new Error(); const html = new DOMParser().parseFromString(await response.text(), 'text/html'); const next = html.querySelector('#gallery-content'); if (!next) throw new Error(); target.replaceWith(next); history.pushState({}, '', anchor.href); document.dispatchEvent(new Event('gallery:updated')); } catch { window.location.href = anchor.href; }
});
window.addEventListener('popstate', () => location.reload());
</script>
