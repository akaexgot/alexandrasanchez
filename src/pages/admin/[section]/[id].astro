---
import Layout from '../../../layouts/AdminLayout.astro';
import Field from '../../../components/AdminField.astro';
import { sections, home, business, type Section, type Content } from '../../../lib/content';
import { z } from 'zod';
const section = Astro.params.section as Section, id = Astro.params.id || '';
if (!Object.hasOwn(sections, section) || (id !== 'nuevo' && !z.uuid().safeParse(id).success)) return Astro.rewrite('/404');
let item: Partial<Content> = { status: 'draft', sort_order: 0 };
if (id === 'nuevo' && section === 'inicio') item = { ...home, status: 'draft' };
if (id === 'nuevo' && section === 'negocio') item = { ...business, status: 'draft' };
if (id !== 'nuevo') {
  const { data, error } = await Astro.locals.supabase!.from(sections[section].table).select('*').eq('id', id).maybeSingle();
  if (error) throw new Error('CONTENT_UNAVAILABLE');
  if (!data) return Astro.rewrite('/404');
  item = data as Content;
}
const needsTreatment = ['resultados', 'opiniones', 'preguntas-frecuentes'].includes(section);
const { data: treatments, error: treatmentError } = needsTreatment ? await Astro.locals.supabase!.from('treatments').select('id,title').order('title').limit(1000) : { data: [], error: null };
if (treatmentError) throw new Error('CONTENT_UNAVAILABLE');
const options = [{ value: '', label: section === 'resultados' ? 'Selecciona un tratamiento' : 'General / sin tratamiento' }, ...(treatments || []).map(t => ({ value: t.id, label: t.title }))];
const title = id === 'nuevo' ? 'Nuevo contenido' : 'Editar contenido';
---
<Layout title={title}><a class="text-link" href={`/admin/${section}`}>← {sections[section].title}</a><h1 style="margin-top:2rem">{id === 'nuevo' ? (section === 'resultados' ? 'Nuevo resultado' : `Añadir contenido`) : item.title}</h1><p class="muted">Guarda los cambios como borrador o publícalos cuando estén preparados.</p>{Astro.url.searchParams.has('saved') && <p class="notice" role="status">Cambios guardados correctamente.</p>}<form class="editor-form" action={`/api/content/${section}`} method="post" data-editor><input type="hidden" name="id" value={id === 'nuevo' ? '' : id}/><p data-feedback role="alert" tabindex="-1" hidden class="notice"></p><Field name="title" label={section === 'preguntas-frecuentes' ? 'Pregunta' : section === 'opiniones' ? 'Título interno' : 'Título'} value={item.title} required/>
{section === 'tratamientos' && <><div class="form-grid"><Field name="slug" label="Dirección del tratamiento" value={item.slug} required help="Se genera al escribir el título. Puedes ajustarla antes de publicar."/><Field name="category" label="Categoría" type="select" value={item.category} options={['Micropigmentación', 'Estética de la mirada'].map(v => ({ value: v, label: v }))}/></div><Field name="summary" label="Resumen" value={item.summary}/><Field name="description" label="Descripción" type="textarea" value={item.description}/><Field name="image_id" label="Imagen principal" type="image" value={item.image_id}/><Field name="featured" label="Destacar en la página de inicio" type="checkbox" value={item.featured}/><p class="notice">Completa los siguientes campos solo con información revisada. Los campos vacíos no se muestran en la web.</p>{[['session_duration', 'Duración de sesión'], ['result_duration', 'Duración de resultados'], ['before_care', 'Cuidados previos'], ['after_care', 'Cuidados posteriores'], ['touch_up', 'Información sobre retoques'], ['seo_title', 'Título para buscadores'], ['seo_description', 'Descripción para buscadores']].map(([name, label]) => <Field name={name} label={label} type="textarea" value={item[name as keyof Content]}/>)}</>}
{section === 'tratamientos' && <div class="form-grid"><Field name="detail_image_id" label="Fotografía adicional 1" type="image" value={item.detail_image_id}/><Field name="second_detail_image_id" label="Fotografía adicional 2" type="image" value={item.second_detail_image_id}/></div>}
{needsTreatment && <Field name="treatment_id" label="Tratamiento" type="select" options={options} value={item.treatment_id} required={section === 'resultados'}/>}
{section === 'resultados' && <><div class="form-grid"><Field name="before_id" label="Fotografía antes" type="image" value={item.before_id}/><Field name="after_id" label="Fotografía después" type="image" value={item.after_id}/></div><Field name="description" label="Descripción (opcional)" type="textarea" value={item.description}/><Field name="featured" label="Destacar en la página de inicio" type="checkbox" value={item.featured}/><Field name="authorized" label="Confirmo que existe autorización válida para publicar estas fotografías" type="checkbox" value={item.authorized}/><p class="muted">Esta confirmación es un control editorial. Conserva los documentos de autorización en un lugar privado; no los subas aquí.</p></>}
{section === 'opiniones' && <><Field name="author" label="Nombre público de la clienta" value={item.author} required/><Field name="description" label="Opinión real" value={item.description} type="textarea" required/><Field name="date" label="Fecha (opcional)" type="date" value={item.date}/><Field name="authorized" label="La clienta ha autorizado la publicación de esta opinión" type="checkbox" value={item.authorized}/></>}
{section === 'preguntas-frecuentes' && <Field name="answer" label="Respuesta" value={item.answer} type="textarea" required/>}
{section === 'inicio' && <><Field name="subtitle" label="Subtítulo" value={item.subtitle} type="textarea"/><Field name="introduction" label="Texto de presentación" value={item.introduction} type="textarea"/><Field name="image_id" label="Fotografía principal" value={item.image_id} type="image"/><Field name="cta" label="Texto del botón de WhatsApp" value={item.cta}/><Field name="instagram_posts" label="Publicaciones de Instagram" value={item.instagram_posts} type="textarea" help="Una URL oficial de publicación o reel por línea."/><p class="notice">Selecciona «Destacar en la página de inicio» en los tratamientos y resultados que quieras mostrar aquí.</p></>}
{section === 'negocio' && <><div class="form-grid"><Field name="phone" label="Teléfono (solo números)" value={item.phone}/><Field name="whatsapp" label="WhatsApp con prefijo de país" value={item.whatsapp}/><Field name="instagram" label="Enlace de Instagram" value={item.instagram} type="url"/><Field name="facebook" label="Enlace verificado de Facebook (opcional)" value={item.facebook} type="url"/></div><Field name="address" label="Dirección confirmada" value={item.address} type="textarea"/><Field name="hours" label="Horarios confirmados" value={item.hours} type="textarea"/><Field name="biography" label="Texto de presentación de Alexandra" value={item.biography} type="textarea"/><Field name="image_id" label="Fotografía de Alexandra" value={item.image_id} type="image"/></>}
<Field name="sort_order" label="Orden (menor número primero)" value={item.sort_order} type="number"/><div class="actions"><button class="button secondary" type="submit" name="status" value="draft">Guardar borrador</button><button class="button" type="submit" name="status" value="published">Publicar</button><a class="text-link" href={`/admin/${section}`}>Cancelar</a></div>{id !== 'nuevo' && !['inicio', 'negocio'].includes(section) && <div style="margin-top:3rem"><button type="button" class="danger" data-delete>Eliminar contenido</button></div>}</form>
<dialog id="confirm-delete"><h2>¿Eliminar este contenido?</h2><p>Esta acción no se puede deshacer. Puedes guardarlo como borrador para ocultarlo sin eliminarlo.</p><div class="actions"><button class="button secondary" data-cancel-delete>Cancelar</button><button class="danger" data-confirm-delete>Eliminar definitivamente</button></div></dialog></Layout>
<script>
import { slugify } from '../../../lib/validation';
const form = document.querySelector<HTMLFormElement>('[data-editor]')!;
const feedback = form.querySelector<HTMLElement>('[data-feedback]')!;
let uploads = 0;
const message = (text: string) => { feedback.textContent = text; feedback.hidden = false; feedback.focus(); };
const slug = form.querySelector<HTMLInputElement>('[name=slug]');
if (slug) { let manual = !!slug.value; slug.addEventListener('input', () => manual = true); form.querySelector<HTMLInputElement>('[name=title]')!.addEventListener('input', event => { if (!manual) slug.value = slugify((event.target as HTMLInputElement).value); }); }
form.querySelectorAll<HTMLElement>('[data-upload]').forEach(container => {
  const file = container.querySelector<HTMLInputElement>('[data-file]')!, hidden = container.querySelector<HTMLInputElement>('input[type=hidden]')!, img = container.querySelector('img')!, status = container.querySelector<HTMLElement>('[data-upload-status]')!;
  container.querySelector('[data-remove]')?.addEventListener('click', () => { hidden.value = ''; img.hidden = true; file.value = ''; });
  file.addEventListener('change', async () => {
    if (!file.files?.[0]) return;
    uploads++; status.textContent = 'Subiendo fotografía…'; file.disabled = true;
    const body = new FormData(); body.set('file', file.files[0]);
    try { const response = await fetch('/api/upload', { method: 'POST', body }); const result = await response.json(); if (!response.ok) throw new Error(result.error); hidden.value = result.id; img.src = result.url; img.hidden = false; status.textContent = 'Fotografía preparada. Guarda el contenido para aplicar el cambio.'; } catch (error) { status.textContent = error instanceof Error ? error.message : 'No se pudo subir la imagen.'; } finally { uploads--; file.disabled = false; }
  });
});
async function save(body: FormData) {
  if (uploads) return message('Espera a que terminen las subidas.');
  const buttons = form.querySelectorAll<HTMLButtonElement>('button'); buttons.forEach(b => b.disabled = true); form.setAttribute('aria-busy', 'true');
  try { const response = await fetch(form.action, { method: 'POST', body }); const result = await response.json(); if (!response.ok) throw new Error(result.error || 'No se pudo guardar.'); location.href = result.redirect; } catch (error) { message(error instanceof Error ? error.message : 'No se pudo guardar. Revisa tu conexión.'); } finally { buttons.forEach(b => b.disabled = false); form.removeAttribute('aria-busy'); }
}
form.addEventListener('submit', event => { event.preventDefault(); const body = new FormData(form); body.set('status', (event.submitter as HTMLButtonElement)?.value || 'draft'); save(body); });
const dialog = document.querySelector<HTMLDialogElement>('#confirm-delete')!;
form.querySelector('[data-delete]')?.addEventListener('click', () => dialog.showModal());
dialog.querySelector('[data-cancel-delete]')?.addEventListener('click', () => dialog.close());
dialog.querySelector('[data-confirm-delete]')?.addEventListener('click', () => { dialog.close(); const body = new FormData(form); body.set('action', 'delete'); save(body); });
</script>
